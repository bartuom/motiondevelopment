{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fxdeck.dev/schema/effect-v1.json",
  "title": "FXDeck Effect Schema V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "durationMs", "layers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "label": { "type": "string", "maxLength": 80 },
    "durationMs": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "priority": { "enum": ["hero", "high", "medium", "low"] },
    "assets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "oneOf": [
          { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "src", "width", "height"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
              "src": { "type": "string", "minLength": 1, "maxLength": 240 },
              "width": { "type": "integer", "minimum": 1, "maximum": 2048 },
              "height": { "type": "integer", "minimum": 1, "maximum": 2048 }
            }
          }
        ]
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["param", "layer", "property", "operation"],
        "properties": {
          "param": { "enum": ["intensity", "tint", "teamColor"] },
          "layer": { "type": "string" },
          "property": {
            "enum": [
              "spawn.count",
              "spawn.ratePerSecond",
              "motion.speed.min",
              "motion.speed.max",
              "size.start",
              "size.end",
              "color"
            ]
          },
          "operation": { "enum": ["multiply", "add", "replace"] },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "spawn", "shape", "lifetimeMs", "motion", "size", "opacity"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "type": { "const": "particles" },
          "delayMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "priority": { "enum": ["hero", "high", "medium", "low"] },
          "z": { "type": "number", "minimum": 0, "maximum": 1000 },
          "blend": { "enum": ["normal", "lighter"] },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number", "minimum": -2048, "maximum": 2048 },
              "y": { "type": "number", "minimum": -2048, "maximum": 2048 },
              "rotateWithDirection": { "type": "boolean" }
            }
          },
          "spawn": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "count"],
                "properties": {
                  "mode": { "const": "burst" },
                  "count": { "type": "integer", "minimum": 1, "maximum": 10000 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "ratePerSecond", "durationMs"],
                "properties": {
                  "mode": { "const": "rate" },
                  "ratePerSecond": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                  "durationMs": { "type": "integer", "minimum": 1, "maximum": 10000 }
                }
              }
            ]
          },
          "shape": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["circle", "square", "image", "ribbon"] },
              "asset": { "type": "string" },
              "ribbon": {
                "type": "object",
                "additionalProperties": false,
                "required": ["points", "spacingPx", "oscillationPx", "oscillationSpeed"],
                "properties": {
                  "points": { "type": "integer", "minimum": 8, "maximum": 80 },
                  "spacingPx": { "type": "number", "minimum": 1, "maximum": 32 },
                  "drag": { "type": "number", "minimum": 0, "maximum": 1 },
                  "darkenPct": { "type": "number", "minimum": 0, "maximum": 100 },
                  "oscillationPx": { "$ref": "#/$defs/range" },
                  "oscillationSpeed": { "$ref": "#/$defs/range" }
                }
              }
            }
          },
          "color": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } }
            ]
          },
          "lifetimeMs": { "$ref": "#/$defs/range" },
          "motion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction", "spreadDeg", "speed"],
            "properties": {
              "direction": {
                "oneOf": [
                  { "type": "number" },
                  { "const": "inherit" }
                ]
              },
              "spreadDeg": { "type": "number", "minimum": 0, "maximum": 360 },
              "speed": { "$ref": "#/$defs/range" },
              "gravity": { "type": "number", "minimum": -100, "maximum": 100 },
              "drag": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "size": { "$ref": "#/$defs/curve2" },
          "opacity": { "$ref": "#/$defs/curve2" },
          "rotationDeg": { "$ref": "#/$defs/range" },
          "orientation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["direction", "motion"] },
              "offsetDeg": { "type": "number", "minimum": -360, "maximum": 360 },
              "jitterDeg": { "type": "number", "minimum": 0, "maximum": 180 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "curve2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "number" },
        "end": { "type": "number" }
      }
    }
  }
}
